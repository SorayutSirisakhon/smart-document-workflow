# Optional Supabase connection values for a future authenticated backend.
# The current app continues to use browser-local storage until the UI is wired
# to Supabase. Never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only LINE Messaging API values. Do not expose these through VITE_*.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
